{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/namanplentyy/thrivee-labs/main/schemas/opportunity-intent.v0.2.schema.json",
  "title": "Thrivee Agent-Native Opportunity Intent v0.2",
  "description": "Canonical JSON-LD representation of a person's temporary employment-market intent. It references a CareerProfile and expires; career history never depends on it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@context",
    "@type",
    "schemaVersion",
    "intentId",
    "subjectRef",
    "validity",
    "disclosure",
    "sourceDocuments",
    "lookingStatus",
    "availability",
    "targetRoles",
    "preferredLocations",
    "workMode",
    "relocation",
    "employmentTypes",
    "compensationExpectation",
    "constraints",
    "preferences",
    "taxonomyMappings",
    "ambiguities",
    "warnings"
  ],
  "properties": {
    "@context": {
      "$ref": "#/$defs/jsonLdContext"
    },
    "@type": {
      "const": "OpportunityIntent"
    },
    "schemaVersion": {
      "const": "0.2.0"
    },
    "intentId": {
      "type": "string",
      "pattern": "^intent:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "subjectRef": {
      "$ref": "#/$defs/profileId"
    },
    "validity": {
      "$ref": "#/$defs/validity"
    },
    "disclosure": {
      "$ref": "#/$defs/disclosure"
    },
    "sourceDocuments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sourceDocument"
      }
    },
    "lookingStatus": {
      "$ref": "#/$defs/lookingStatusClaim"
    },
    "availability": {
      "$ref": "#/$defs/availability"
    },
    "targetRoles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intentTarget"
      }
    },
    "preferredLocations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/locationPreference"
      }
    },
    "workMode": {
      "$ref": "#/$defs/workModeClaim"
    },
    "relocation": {
      "$ref": "#/$defs/relocation"
    },
    "employmentTypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/employmentTypeClaim"
      }
    },
    "compensationExpectation": {
      "anyOf": [
        {
          "$ref": "#/$defs/compensationExpectation"
        },
        {
          "type": "null"
        }
      ]
    },
    "constraints": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intentConstraint"
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/intentPreference"
      }
    },
    "taxonomyMappings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/taxonomyMapping"
      }
    },
    "ambiguities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ambiguity"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    }
  },
  "$defs": {
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "kind",
        "status",
        "fieldPath",
        "reason",
        "relatedRefs",
        "candidates",
        "selectedValue"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ambiguity:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "Ambiguity"
        },
        "kind": {
          "type": "string",
          "enum": [
            "association",
            "shared-description",
            "repeated-occurrence",
            "date-interpretation",
            "classification",
            "field-value",
            "taxonomy-mapping",
            "other"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "unresolved",
            "resolved",
            "deferred"
          ]
        },
        "fieldPath": {
          "type": "string",
          "pattern": "^/"
        },
        "reason": {
          "$ref": "#/$defs/stringClaim"
        },
        "relatedRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityId"
          },
          "uniqueItems": true
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ambiguityCandidate"
          }
        },
        "selectedValue": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "resolved"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "selectedValue": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "unresolved",
                  "deferred"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "selectedValue": {
                "type": "null"
              }
            }
          }
        }
      ]
    },
    "ambiguityCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "candidateRefs",
        "confidence",
        "provenance"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "candidateRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityId"
          },
          "uniqueItems": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "availability": {
      "description": "Unstated availability stays null. A notice period is never derived from a job start date.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "availableFrom",
        "noticePeriod",
        "note",
        "provenance"
      ],
      "properties": {
        "availableFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/normalizedDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "noticePeriod": {
          "anyOf": [
            {
              "$ref": "#/$defs/noticePeriod"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/stringClaim"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "claimId": {
      "type": "string",
      "pattern": "^claim:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "compensationExpectation": {
      "description": "Optional and never inferred. The whole object stays null when the subject has not stated an expectation; an amount requires an explicit currency and period.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "amountMin",
        "amountMax",
        "currency",
        "period",
        "basis",
        "negotiable",
        "note",
        "validity",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^compensation:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "CompensationExpectation"
        },
        "amountMin": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "amountMax": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "currency": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "period": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "month",
                "year",
                "project"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "gross",
                "net",
                "ctc",
                "unknown"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "negotiable": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "note": {
          "anyOf": [
            {
              "$ref": "#/$defs/stringClaim"
            },
            {
              "type": "null"
            }
          ]
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "amountMin": {
                "type": "number"
              }
            },
            "required": [
              "amountMin"
            ]
          },
          "then": {
            "properties": {
              "currency": {
                "type": "string"
              },
              "period": {
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "amountMax": {
                "type": "number"
              }
            },
            "required": [
              "amountMax"
            ]
          },
          "then": {
            "properties": {
              "currency": {
                "type": "string"
              },
              "period": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "disclosure": {
      "description": "What an agent may discover without permission versus what requires an explicit grant. This object never records requester identities, marketplace transactions, or consent history; candidate-authorized disclosure to a named requester is the separate future DisclosureGrant contract.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "defaultVisibility",
        "basis",
        "rules",
        "notes",
        "validity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^disclosure:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "DisclosurePolicy"
        },
        "defaultVisibility": {
          "type": "string",
          "enum": [
            "agent-discoverable",
            "requires-grant",
            "withheld"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "subject-configured",
            "producer-default",
            "policy-default"
          ]
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/disclosureRule"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "validity": {
          "$ref": "#/$defs/validity"
        }
      }
    },
    "disclosureRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "selector",
        "visibility",
        "basis",
        "note",
        "validity"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^disclosure-rule:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "DisclosureRule"
        },
        "selector": {
          "$ref": "#/$defs/disclosureSelector"
        },
        "visibility": {
          "type": "string",
          "enum": [
            "agent-discoverable",
            "requires-grant",
            "withheld"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "subject-configured",
            "producer-default",
            "policy-default"
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "validity": {
          "$ref": "#/$defs/validity"
        }
      }
    },
    "disclosureSelector": {
      "description": "Exactly one selector dimension is populated, which makes rule precedence deterministic: entityRefs beats sensitivities, which beats collections, which beats the default.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entityRefs",
        "sensitivities",
        "collections"
      ],
      "properties": {
        "entityRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityId"
          },
          "uniqueItems": true
        },
        "sensitivities": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "standard",
              "sensitive",
              "highly-sensitive"
            ]
          },
          "uniqueItems": true
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][A-Za-z0-9]*$"
          },
          "uniqueItems": true
        }
      },
      "oneOf": [
        {
          "properties": {
            "entityRefs": {
              "minItems": 1
            },
            "sensitivities": {
              "maxItems": 0
            },
            "collections": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "entityRefs": {
              "maxItems": 0
            },
            "sensitivities": {
              "minItems": 1
            },
            "collections": {
              "maxItems": 0
            }
          }
        },
        {
          "properties": {
            "entityRefs": {
              "maxItems": 0
            },
            "sensitivities": {
              "maxItems": 0
            },
            "collections": {
              "minItems": 1
            }
          }
        }
      ]
    },
    "employmentTypeClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "value",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^employment-type:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "EmploymentTypePreference"
        },
        "value": {
          "type": "string",
          "enum": [
            "full-time",
            "part-time",
            "contract",
            "internship",
            "apprenticeship",
            "temporary",
            "freelance",
            "volunteer",
            "other"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "entityId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "instant": {
      "description": "A calendar date, or a UTC date-time, at which something was observed or recorded.",
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}Z)?$"
    },
    "intentAspect": {
      "type": "string",
      "enum": [
        "schedule",
        "travel",
        "work-environment",
        "company-stage",
        "industry",
        "contract-duration",
        "team-size",
        "other"
      ]
    },
    "intentConstraint": {
      "description": "Hard filters for aspects that have no typed field. Location, work mode, relocation, employment type, availability and compensation have typed fields and must not be restated here.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "kind",
        "operator",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^constraint:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "IntentConstraint"
        },
        "kind": {
          "$ref": "#/$defs/intentAspect"
        },
        "operator": {
          "type": "string",
          "enum": [
            "equals",
            "one-of",
            "none-of",
            "minimum",
            "maximum",
            "requires",
            "forbids"
          ]
        },
        "value": {
          "$ref": "#/$defs/stringClaim"
        }
      }
    },
    "intentPreference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "kind",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^preference:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "IntentPreference"
        },
        "kind": {
          "$ref": "#/$defs/intentAspect"
        },
        "value": {
          "$ref": "#/$defs/stringClaim"
        }
      }
    },
    "intentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "kind",
        "value"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^target:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "IntentTarget"
        },
        "kind": {
          "type": "string",
          "enum": [
            "role",
            "occupation",
            "career-family",
            "industry"
          ]
        },
        "value": {
          "$ref": "#/$defs/stringClaim"
        }
      }
    },
    "jsonLdContext": {
      "description": "Inline transport-safe context. `id` and `type` are JSON-LD keyword aliases, so every identified entity is a real JSON-LD node rather than an anonymous nested object. contexts/career-v0.2.context.jsonld carries the full term definitions.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "@vocab",
        "schema",
        "ceasn",
        "skos",
        "id",
        "type"
      ],
      "properties": {
        "@vocab": {
          "const": "https://github.com/namanplentyy/thrivee-labs/ns/career#"
        },
        "schema": {
          "const": "https://schema.org/"
        },
        "ceasn": {
          "const": "https://purl.org/ctdlasn/terms/"
        },
        "skos": {
          "const": "http://www.w3.org/2004/02/skos/core#"
        },
        "id": {
          "const": "@id"
        },
        "type": {
          "const": "@type"
        }
      }
    },
    "locationPreference": {
      "description": "Only the granularity the source supports. No geocoding and no widening to a region.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "label",
        "granularity",
        "countryCode",
        "strength",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^location:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "LocationPreference"
        },
        "label": {
          "$ref": "#/$defs/stringClaim"
        },
        "granularity": {
          "type": "string",
          "enum": [
            "country",
            "state-or-region",
            "city",
            "district",
            "site",
            "other"
          ]
        },
        "countryCode": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "strength": {
          "type": "string",
          "enum": [
            "required",
            "preferred",
            "acceptable"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "lookingStatusClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/claimId"
        },
        "value": {
          "type": "string",
          "enum": [
            "actively-looking",
            "open-to-offers",
            "not-looking",
            "unknown"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "normalizedDate": {
      "type": "string",
      "pattern": "^[0-9]{4}(-[0-9]{2}(-[0-9]{2})?)?$"
    },
    "noticePeriod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "enum": [
            "day",
            "week",
            "month"
          ]
        }
      }
    },
    "numberClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/claimId"
        },
        "value": {
          "type": "number",
          "minimum": 0
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "profileId": {
      "type": "string",
      "pattern": "^profile:[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "provenance": {
      "description": "Origination, verification, confidence and source location stay separate dimensions. A verificationStatus other than self-attested or unverified additionally requires a confirmed Verification record resolving to the claim or its owning entity.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "verificationStatus",
        "confidence",
        "source",
        "inferringAgent"
      ],
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "resume-explicit",
            "user-entered",
            "agent-inferred",
            "institution-issued",
            "peer-endorsed",
            "deterministic-normalization"
          ]
        },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "self-attested",
            "unverified",
            "institution-verified",
            "peer-endorsed"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceLocator"
            },
            {
              "type": "null"
            }
          ]
        },
        "inferringAgent": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "method": {
                "const": "agent-inferred"
              }
            },
            "required": [
              "method"
            ]
          },
          "then": {
            "properties": {
              "verificationStatus": {
                "const": "unverified"
              },
              "inferringAgent": {
                "type": "string",
                "format": "uri"
              }
            }
          }
        }
      ]
    },
    "relocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "willingness",
        "conditions",
        "targetLocationRefs",
        "provenance"
      ],
      "properties": {
        "willingness": {
          "type": "string",
          "enum": [
            "willing",
            "not-willing",
            "conditional",
            "unknown"
          ]
        },
        "conditions": {
          "anyOf": [
            {
              "$ref": "#/$defs/stringClaim"
            },
            {
              "type": "null"
            }
          ]
        },
        "targetLocationRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^location:[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "uniqueItems": true
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "willingness": {
                "const": "conditional"
              }
            },
            "required": [
              "willingness"
            ]
          },
          "then": {
            "properties": {
              "conditions": {
                "$ref": "#/$defs/stringClaim"
              }
            }
          }
        }
      ]
    },
    "sourceDocument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "mediaType",
        "contentDigest",
        "extractionMethod",
        "pageCount",
        "ingestedAt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^source:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "SourceDocument"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "contentDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "extractionMethod": {
          "type": "string",
          "enum": [
            "native-text",
            "document-parser",
            "ocr",
            "user-entry",
            "api-import",
            "other"
          ]
        },
        "pageCount": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ingestedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "sourceLocator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "documentId",
        "page",
        "charStart",
        "charEnd",
        "sourceText",
        "textDigest",
        "textNormalization"
      ],
      "properties": {
        "documentId": {
          "type": "string",
          "pattern": "^source:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "page": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "charStart": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "charEnd": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "sourceText": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "textDigest": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "textNormalization": {
          "type": "string",
          "enum": [
            "exact",
            "unicode-normalized",
            "whitespace-normalized",
            "extraction-substitution",
            "unavailable"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "charStart": {
                "type": "integer"
              }
            },
            "required": [
              "charStart"
            ]
          },
          "then": {
            "properties": {
              "charEnd": {
                "type": "integer"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "charEnd": {
                "type": "integer"
              }
            },
            "required": [
              "charEnd"
            ]
          },
          "then": {
            "properties": {
              "charStart": {
                "type": "integer"
              }
            }
          }
        }
      ]
    },
    "stringClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/claimId"
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "taxonomyCandidate": {
      "description": "A possible code that has not been adopted. `agent-suggested` is allowed here and nowhere else; a candidate never becomes the resolved mapping without review.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "uri",
        "label",
        "matchType",
        "method",
        "confidence",
        "provenance"
      ],
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "matchType": {
          "type": "string",
          "enum": [
            "exact-match",
            "close-match",
            "broad-match",
            "narrow-match",
            "related-match",
            "unknown"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "agent-suggested",
            "explicit-in-source",
            "registry-verified",
            "manual-reviewed"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    },
    "taxonomyMapping": {
      "description": "A first-class, provenance-aware mapping from a local subject to an external framework. An unknown mapping stays unknown: record mappingStatus `unmapped` or `ambiguous` rather than omitting the mapping or adopting a guess.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "subjectRef",
        "framework",
        "frameworkVersion",
        "mappingStatus",
        "code",
        "uri",
        "label",
        "matchType",
        "mappingMethod",
        "candidates",
        "validity",
        "notes",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^taxonomy-mapping:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "TaxonomyMapping"
        },
        "subjectRef": {
          "$ref": "#/$defs/entityId"
        },
        "framework": {
          "type": "string",
          "enum": [
            "NCO-2015",
            "ESCO",
            "O*NET",
            "CTDL-ASN",
            "NSQF",
            "other"
          ]
        },
        "frameworkVersion": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "mappingStatus": {
          "type": "string",
          "enum": [
            "mapped",
            "unmapped",
            "ambiguous",
            "rejected"
          ]
        },
        "code": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "uri": {
          "anyOf": [
            {
              "type": "string",
              "format": "uri"
            },
            {
              "type": "null"
            }
          ]
        },
        "label": {
          "anyOf": [
            {
              "$ref": "#/$defs/stringClaim"
            },
            {
              "type": "null"
            }
          ]
        },
        "matchType": {
          "type": "string",
          "enum": [
            "exact-match",
            "close-match",
            "broad-match",
            "narrow-match",
            "related-match",
            "no-match",
            "unknown"
          ]
        },
        "mappingMethod": {
          "type": "string",
          "enum": [
            "explicit-in-source",
            "registry-verified",
            "manual-reviewed",
            "reviewed-no-match",
            "not-attempted"
          ]
        },
        "candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taxonomyCandidate"
          }
        },
        "validity": {
          "$ref": "#/$defs/validity"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mappingStatus": {
                "const": "mapped"
              }
            },
            "required": [
              "mappingStatus"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              },
              "matchType": {
                "type": "string",
                "enum": [
                  "exact-match",
                  "close-match",
                  "broad-match",
                  "narrow-match",
                  "related-match"
                ]
              },
              "mappingMethod": {
                "type": "string",
                "enum": [
                  "explicit-in-source",
                  "registry-verified",
                  "manual-reviewed"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mappingStatus": {
                "const": "unmapped"
              }
            },
            "required": [
              "mappingStatus"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "null"
              },
              "matchType": {
                "type": "string",
                "enum": [
                  "no-match",
                  "unknown"
                ]
              },
              "mappingMethod": {
                "type": "string",
                "enum": [
                  "reviewed-no-match",
                  "not-attempted"
                ]
              },
              "candidates": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mappingStatus": {
                "const": "ambiguous"
              }
            },
            "required": [
              "mappingStatus"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "null"
              },
              "matchType": {
                "const": "unknown"
              },
              "candidates": {
                "minItems": 2
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "mappingStatus": {
                "const": "rejected"
              }
            },
            "required": [
              "mappingStatus"
            ]
          },
          "then": {
            "properties": {
              "code": {
                "type": "null"
              },
              "matchType": {
                "const": "no-match"
              }
            }
          }
        }
      ]
    },
    "validity": {
      "description": "Temporal metadata for state that can become stale. `observedAt` is when a producer observed the state. `lastConfirmedAt` is set only when the subject or an authoritative issuer confirmed it; extraction time is not confirmation.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validFrom",
        "validUntil",
        "observedAt",
        "lastConfirmedAt"
      ],
      "properties": {
        "validFrom": {
          "anyOf": [
            {
              "$ref": "#/$defs/normalizedDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "validUntil": {
          "anyOf": [
            {
              "$ref": "#/$defs/normalizedDate"
            },
            {
              "type": "null"
            }
          ]
        },
        "observedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastConfirmedAt": {
          "anyOf": [
            {
              "$ref": "#/$defs/instant"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "code",
        "severity",
        "message",
        "relatedRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^warning:[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "type": {
          "const": "Warning"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "relatedRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityId"
          },
          "uniqueItems": true
        }
      }
    },
    "workModeClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "value",
        "provenance"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/claimId"
        },
        "value": {
          "type": "string",
          "enum": [
            "onsite",
            "hybrid",
            "remote",
            "no-preference",
            "unknown"
          ]
        },
        "provenance": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/provenance"
          },
          "minItems": 1
        }
      }
    }
  }
}
