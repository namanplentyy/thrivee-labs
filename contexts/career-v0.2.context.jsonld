{
  "@context": {
    "@version": 1.1,
    "@vocab": "https://github.com/namanplentyy/thrivee-labs/ns/career#",
    "schema": "https://schema.org/",
    "ceasn": "https://purl.org/ctdlasn/terms/",
    "skos": "http://www.w3.org/2004/02/skos/core#",

    "id": "@id",
    "type": "@type",
    "profileId": "@id",
    "intentId": "@id",

    "subjectRef": { "@type": "@id" },
    "targetRef": { "@type": "@id" },
    "documentId": { "@type": "@id" },
    "sourceDocumentRef": { "@type": "@id" },
    "supportingArtifactRef": { "@type": "@id" },
    "ambiguityRef": { "@type": "@id" },
    "ambiguityRefs": { "@type": "@id", "@container": "@set" },
    "candidateEngagementRefs": { "@type": "@id", "@container": "@set" },
    "resolvedEngagementRefs": { "@type": "@id", "@container": "@set" },
    "contextRefs": { "@type": "@id", "@container": "@set" },
    "evidenceRefs": { "@type": "@id", "@container": "@set" },
    "exercisesRefs": { "@type": "@id", "@container": "@set" },
    "relatedRefs": { "@type": "@id", "@container": "@set" },
    "candidateRefs": { "@type": "@id", "@container": "@set" },
    "entityRefs": { "@type": "@id", "@container": "@set" },
    "targetLocationRefs": { "@type": "@id", "@container": "@set" },

    "matchType": { "@type": "@vocab" },
    "exact-match": "skos:exactMatch",
    "close-match": "skos:closeMatch",
    "broad-match": "skos:broadMatch",
    "narrow-match": "skos:narrowMatch",
    "related-match": "skos:relatedMatch"
  }
}
